{
    "name": "roundly-consulting/auth-for-laravel",
    "description": "Headless multi-guard authentication for Laravel: password, magic link, email OTP and passkey login, 2FA challenges, JWT + rotating refresh sessions, invitations, verification and activity logging.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "auth",
        "authentication",
        "jwt",
        "passkeys",
        "2fa",
        "magic-link",
        "otp",
        "sessions"
    ],
    "homepage": "https://github.com/roundly-consulting/auth-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../crypto-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/crypto-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../enums-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/enums-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../jwt-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/jwt-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../money-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/money-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../package-toolkit-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/package-toolkit-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../passkeys-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/passkeys-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../qr-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/qr-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../refresh-tokens-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/refresh-tokens-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../two-factor-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/two-factor-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../testing-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/testing-for-laravel",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/translation": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "roundly-consulting/crypto-for-laravel": "@dev",
        "roundly-consulting/enums-for-laravel": "@dev",
        "roundly-consulting/jwt-for-laravel": "@dev",
        "roundly-consulting/package-toolkit-for-laravel": "@dev",
        "roundly-consulting/passkeys-for-laravel": "@dev",
        "roundly-consulting/qr-for-laravel": "@dev",
        "roundly-consulting/refresh-tokens-for-laravel": "@dev",
        "roundly-consulting/two-factor-for-laravel": "@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "roundly-consulting/testing-for-laravel": "@dev"
    },
    "suggest": {
        "roundly-consulting/permissions-for-laravel": "Bind ResolvesAccessTokenClaims to put effective permissions into the access token.",
        "roundly-consulting/geolocation-for-laravel": "Listen to LoginActivityRecorded / TokensIssued to enrich activity rows and sessions with location."
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Auth\\": "src/",
            "RoundlyConsulting\\Auth\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Auth\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=2G",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Auth\\AuthenticationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
